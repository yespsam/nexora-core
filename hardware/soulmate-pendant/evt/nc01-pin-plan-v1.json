{
  "version": 1,
  "model": "NC-01",
  "board": "Waveshare ESP32-S3-LCD-1.28 non-touch",
  "stage": "EVT-A",
  "updatedAt": "2026-08-03",
  "source": "https://www.waveshare.com/wiki/ESP32-S3-LCD-1.28",
  "reserved": [
    { "gpio": 0, "function": "boot" },
    { "gpio": 1, "function": "battery-adc" },
    { "gpio": 6, "function": "imu-sda" },
    { "gpio": 7, "function": "imu-scl" },
    { "gpio": 8, "function": "lcd-dc" },
    { "gpio": 9, "function": "lcd-cs" },
    { "gpio": 10, "function": "lcd-clock" },
    { "gpio": 11, "function": "lcd-mosi" },
    { "gpio": 12, "function": "lcd-reset" },
    { "gpio": 40, "function": "lcd-backlight" },
    { "gpio": 43, "function": "usb-uart-tx" },
    { "gpio": 44, "function": "usb-uart-rx" },
    { "gpio": 47, "function": "imu-int1" },
    { "gpio": 48, "function": "imu-int2" }
  ],
  "avoid": [
    { "gpio": 45, "reason": "ESP32-S3 strapping pin" },
    { "gpio": 46, "reason": "ESP32-S3 strapping pin" }
  ],
  "assignments": [
    { "gpio": 13, "signal": "audio-bclk", "direction": "output", "device": "shared I2S clock" },
    { "gpio": 14, "signal": "audio-lrclk", "direction": "output", "device": "shared I2S word select" },
    { "gpio": 15, "signal": "microphone-data", "direction": "input", "device": "SPH0645LM4H" },
    { "gpio": 16, "signal": "speaker-data", "direction": "output", "device": "MAX98357A" },
    { "gpio": 17, "signal": "amplifier-shutdown", "direction": "output", "device": "MAX98357A SD" },
    { "gpio": 18, "signal": "status-light-data", "direction": "output", "device": "EVT status light" },
    { "gpio": 39, "signal": "mic-mute-sense", "direction": "input", "device": "physical mute switch" },
    { "gpio": 4, "signal": "haptic-a", "direction": "output", "device": "onboard MOS contact" },
    { "gpio": 5, "signal": "haptic-b", "direction": "output", "device": "optional second onboard MOS contact" }
  ],
  "rules": [
    "物理静音开关必须同时切断麦克风供电，GPIO39 只读取可见状态。",
    "GPIO4/GPIO5 只能在核对实板 MOS 触点与极性后连接马达。",
    "EVT-A 首次通电使用限流电源或 USB，电池最后接入。",
    "EVT-B 集成小板可以更换器件封装，但不得改变手机网关与 NXR1 BLE 契约。"
  ]
}
